# Copy to ~/.alphaosint/.env
APIFY_TOKEN=
# Hard spend caps enforced by the server (USD). The email step needs at least 0.50 left in the session.
PROSPECTOR_SESSION_BUDGET_USD=2.00
PROSPECTOR_CALL_BUDGET_USD=1.00
# Your Apify plan tier, used to price tiered events in the spend log: FREE, BRONZE, SILVER, GOLD
PROSPECTOR_APIFY_TIER=BRONZE
